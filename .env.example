# คัดลอกเป็น .env.local สำหรับ dev — บน Vercel ตั้งที่ Settings → Environment Variables

# ฟอร์มติดต่อ (Resend) — จำเป็นถ้าต้องการให้ฟอร์มส่งอีเมลได้
RESEND_API_KEY=

# ไม่บังคับ — ค่าเริ่มต้น: อีเมลใน src/config/site.ts
# CONTACT_TO_EMAIL=you@example.com

# ไม่บังคับ — ค่าเริ่มต้น: "Portfolio <onboarding@resend.dev>"
# (ใช้ได้เฉพาะส่งเข้าอีเมลที่สมัคร Resend ไว้ ถ้าจะใช้อีเมลโดเมนตัวเองต้อง verify โดเมนใน Resend ก่อน)
# CONTACT_FROM_EMAIL=Portfolio <hello@your-domain.com>

# ไม่บังคับ — บังคับ URL หลักของเว็บ (canonical / OG / sitemap)
# NEXT_PUBLIC_SITE_URL=https://your-domain.com
